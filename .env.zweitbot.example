# Vorlage für die Test-Instanz (docker-compose.zweitbot.yml). Nach .env.zweitbot kopieren
# und ausfüllen – .env.zweitbot ist git-ignoriert und darf NIE ins Repo.
XAI_API_KEY=
TELEGRAM_BOT_TOKEN=          # Token eines ZWEITEN Bots (BotFather), nicht der Live-Bot
DOMINA_CHAT_ID=              # Test-Konto 1 (führende Rolle / Partner A)
SKLAVE_CHAT_ID=              # Test-Konto 2 (devote Rolle / Partner B)
OLLAMA_URL=http://host.docker.internal:11434
TIMEZONE=Europe/Berlin
SAFEWORD=rot
PAIRING_ENABLED=true         # weitere Test-Paare per /start-Pairing
GROK_MODEL=grok-4.20-non-reasoning
LLM_TIMEOUT=120
