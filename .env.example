# --- Required -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=            # from @BotFather
DOMINA_CHAT_ID=                # Telegram chat ID of the dominant partner
SKLAVE_CHAT_ID=                # Telegram chat ID of the submissive partner
XAI_API_KEY=                   # xAI (Grok) API key

# --- Infrastructure ------------------------------------------------------
QDRANT_URL=http://localhost:6333   # docker-compose overrides this with http://qdrant:6333
# QDRANT_API_KEY=                  # recommended: set the same value as
                                   # QDRANT__SERVICE__API_KEY on the qdrant
                                   # container (e.g. via a compose override)
# Embeddings are REQUIRED. Either run the bundled compose profile
# (docker compose --profile ollama up -d ollama, then pull the model – see
# docker-compose.yml header) and use the service URL below, or point this
# at an existing Ollama on your host/LAN (e.g. http://192.0.2.10:11434).
OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=                    # default: German jina-embeddings (see bot/config.py);
                                   # non-German deployments: use a multilingual model
# EMBEDDING_DIM=768                # must match the embedding model; changing it
                                   # requires re-embedding all collections!

# --- Language / Locale ---------------------------------------------------
# BOT_LOCALE=de                    # UI texts + command aliases: "de" or "en"
                                   # (the LLM reply language is configured at
                                   # runtime via /einstellungen instead)

# --- Safety --------------------------------------------------------------
SAFEWORD=stopp                     # checked case-insensitively on EVERY message
RESUME_WORT=weiter                 # word that lifts the safeword pause

# --- Behaviour (defaults are fine) ---------------------------------------
TIMEZONE=Europe/Berlin
FOLLOWUP_TIME=09:00
STIMMUNG_ENABLED=false
TRAINING_ENABLED=true
# GROK_MODEL=grok-4.3
# GROK_MODEL_REASONING=            # optional stronger model for complex prompts
# GROK_SUPPORTS_PENALTIES=false    # grok-4.x rejects frequency/presence_penalty
# PERSONA_PRESETS_DIR=data/persona_presets  # your own style presets / rule overrides

# --- Log server (OFF by default – logs contain intimate content!) --------
# The log server speaks plain HTTP (no TLS). If you enable it, bind it to
# 127.0.0.1 only (see docker-compose.yml) and access it via an SSH tunnel.
# It refuses to start without Basic-Auth users (fail-closed).
LOG_PORT=0                         # 0 = disabled; e.g. 8099 to enable
LOG_USERS=                         # REQUIRED to enable: user:password[,user2:pw2]
LOG_TOKEN=                         # optional extra token (query parameter)

# --- Voice messages (optional, fully local TTS) ---------------------------
# Piper via the Wyoming protocol (e.g. a wyoming-piper container). If set,
# task deliveries additionally arrive as Telegram voice messages spoken by
# the dominant persona. Fully local - no cloud TTS.
TTS_WYOMING_URL=                   # compose profile 'voice': tcp://piper:10200; own server: tcp://192.0.2.10:10200; empty = off
# TTS_VOICE=                       # e.g. de_DE-kerstin-low; empty = server default

# Understanding voice messages (optional, fully local STT via wyoming-whisper).
# If set, voice messages are transcribed and handled like typed text
# (incl. safeword check); empty = old behaviour (media forwarding).
STT_WYOMING_URL=                   # compose profile 'voice': tcp://whisper:10300; own server: tcp://192.0.2.10:10300; empty = off
# STT_SPRACHE=                     # e.g. de; empty = server default

# --- Fallback LLM (optional, e.g. local Ollama) --------------------------
FALLBACK_LLM_URL=                  # empty = no fallback when Grok is down
FALLBACK_LLM_KEY=
FALLBACK_LLM_MODEL=
# Local emergency model for the slave chat when Grok is down: runs on OLLAMA_URL
# with a slimmed-down prompt (full prompt is too slow for CPU inference). Empty = off.
LOKAL_LLM_MODEL=                   # e.g. krith/mistral-nemo-instruct-2407-abliterated:IQ4_XS
# LOKAL_LLM_TIMEOUT=180            # seconds; CPU inference is slow

# --- Backups -------------------------------------------------------------
# BACKUP_KEEP=14                   # number of JSON backups to keep

# --- Multiuser (optional) --------------------------------------------------
# Registration of additional couples via /start + invite code. Default: off.
# The env couple (DOMINA_CHAT_ID/SKLAVE_CHAT_ID) always exists as couple "1";
# additional couples are stored in PAARE_FILE (mounted volume).
# PAIRING_ENABLED=false
# INVITE_TTL_STUNDEN=48            # invite code validity in hours
# CONCURRENT_UPDATES=8             # parallel update processing across couples (1 = serial)
# QDRANT_IO_WORKERS=4              # Qdrant I/O threads (1 = old serial behaviour)
# ADMIN_CHAT_ID=                   # operator chat for /paare + /paar_loeschen (empty = off)
# LLM_BUDGET_PRO_TAG=0             # max chat messages per couple per day reaching the LLM (0 = off)
# TTS_STIMMEN=                     # per-language Piper voices, e.g. "de=de_DE-thorsten-high,en=en_US-lessac-high"
